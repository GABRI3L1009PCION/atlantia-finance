APP_NAME="Atlantia Finance (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_FORCE_HTTPS=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_GT
APP_TIMEZONE=America/Guatemala

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=atlantia_finance_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BACKUP_ENABLED=false
BACKUP_DESTINATION=/var/backups/atlantia-finance
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
BACKUP_PG_DUMP_BINARY=/usr/bin/pg_dump
BACKUP_PG_RESTORE_BINARY=/usr/bin/pg_restore
BACKUP_TAR_BINARY=/usr/bin/tar
BACKUP_AWS_BINARY=/usr/bin/aws

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@staging.example.com
MAIL_FROM_NAME="${APP_NAME}"

RECURRENTE_API_URL=https://app.recurrente.com/api
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_ENVIRONMENT=test

ATLANTIA_AI_URL=http://127.0.0.1:8100

VITE_APP_NAME="${APP_NAME}"
