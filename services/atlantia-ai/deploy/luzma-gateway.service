# systemd unit for Linux servers. Copy to /etc/systemd/system/, adjust User and the paths, then:
#   systemctl daemon-reload && systemctl enable --now luzma-gateway
# Ollama must run as its own service (ollama.service) with OLLAMA_KEEP_ALIVE=-1.
[Unit]
Description=Luzma gateway (FastAPI) for Atlantia Finance
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=atlantia
WorkingDirectory=/var/www/atlantia-finance/services/atlantia-ai
EnvironmentFile=/var/www/atlantia-finance/services/atlantia-ai/.env
ExecStart=/var/www/atlantia-finance/services/atlantia-ai/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
