FEL_PROVIDER=sat_manual
FEL_SAT_PORTAL_URL=https://portal.sat.gob.gt
FEL_SAT_PENDING_ALERT_DAYS=2
FEL_ENVIRONMENT=test
FEL_API_URL=
FEL_API_KEY=
FEL_USERNAME=
FEL_PASSWORD=
FEL_QUEUE_CONNECTION=database
FEL_QUEUE=default
FEL_SUBSCRIPTION_ISSUER=
FEL_PLATFORM_NAME="Atlantia Systems"
FEL_PLATFORM_NIT=97655988
FEL_PLATFORM_ADDRESS="Colonia la Repegua Santo Tomas de Castilla"

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlantia_finance
DB_USERNAME=atlantia_finance_user
DB_PASSWORD=
DB_SSLMODE=prefer

# Orígenes de navegador que pueden llamar a /api (separados por coma). Vacío = ninguno; la API es para servidores.
CORS_ALLOWED_ORIGINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# En producción (APP_ENV=production) la sesión se cifra y la cookie es segura por defecto.
# Con APP_DEBUG=false, HTTPS activo y SESSION_SECURE_COOKIE=true no hace falta tocar nada más.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

BACKUP_ENABLED=false
BACKUP_DESTINATION=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_PG_RESTORE_BINARY=pg_restore
BACKUP_TAR_BINARY=tar
BACKUP_AWS_BINARY=aws

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ATLANTIA_AI_URL=http://127.0.0.1:8100
LUZMA_ENABLED=true
# Proveedores del modelo en orden de preferencia: gemini, ollama. Si el primero falla responde el siguiente.
LUZMA_PROVIDERS=ollama
# Clave de Gemini con FACTURACIÓN ACTIVA (el nivel gratuito puede usar los datos para mejorar productos de Google).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LUZMA_PLAN_TIMEOUT=25
LUZMA_ANSWER_TIMEOUT=90

VITE_APP_NAME="${APP_NAME}"

# Horario de servicio: fuera de él se muestra la página de cierre (se apaga sola con false).
SERVICE_HOURS_ENABLED=false
SERVICE_HOURS_FORCE_CLOSED=false
SERVICE_HOURS_TIMEZONE=America/Guatemala
SERVICE_HOURS_OPENS_AT=06:00
SERVICE_HOURS_CLOSES_AT=23:00
